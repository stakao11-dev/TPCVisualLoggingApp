# 既定: テキストと判定されたファイルはリポジトリ内で LF に正規化する
* text=auto

# Windows / Visual Studio 系のファイルは作業コピーでも CRLF に固定する
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.config    text eol=crlf
*.resx      text eol=crlf
*.xaml      text eol=crlf
*.cs        text eol=crlf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# シェルスクリプトは LF に固定する
*.sh        text eol=lf

# バイナリ (改行変換・差分表示をしない)
*.dll       binary
*.exe       binary
*.lib       binary
*.pdb       binary
*.pdf       binary
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.zip       binary
*.snk       binary
*.pfx       binary
