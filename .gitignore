# ユーザー固有ファイル
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio キャッシュ / 作業フォルダ
.vs/

# ビルド結果
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
# ベンダー DLL 置き場 (lib/x64, lib/x86) は除外しない ※フォルダ名は仮置き
!lib/x64/
!lib/x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
# [Ll]og/ と [Ll]ogs/ は除外しない (ログ関連のソースフォルダ名と衝突するため)

# MSTest / テスト結果
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

