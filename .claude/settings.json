{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",

      "Bash(powershell -ExecutionPolicy Bypass -File scripts/build.ps1:*)",
      "PowerShell(./scripts/build.ps1:*)",
      "PowerShell(.\\scripts\\build.ps1:*)",

      "Bash(.venv/Scripts/python scripts/convert_pdf.py:*)",
      "PowerShell(.venv/Scripts/python scripts/convert_pdf.py:*)",
      "PowerShell(.\\.venv\\Scripts\\python scripts\\convert_pdf.py:*)",

      "WebFetch(domain:learn.microsoft.com)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git stash:*)",

      "Edit(./scripts/build.ps1)",
      "Write(./scripts/build.ps1)",

      "Bash(dotnet add:*)",
      "Bash(nuget install:*)",
      "Bash(.venv/Scripts/pip install:*)",
      "PowerShell(dotnet add:*)",
      "PowerShell(nuget install:*)",
      "PowerShell(Install-Package:*)",
      "PowerShell(.venv/Scripts/pip install:*)",
      "PowerShell(.\\.venv\\Scripts\\pip install:*)",
      "Edit(./**/packages.config)",
      "Write(./**/packages.config)",

      "Bash(*bin/Debug/*)",
      "Bash(*bin/Release/*)",
      "Bash(*vstest.console*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet test:*)",
      "PowerShell(*bin\\Debug\\*)",
      "PowerShell(*bin\\Release\\*)",
      "PowerShell(*bin/Debug/*)",
      "PowerShell(*bin/Release/*)",
      "PowerShell(*vstest.console*)",
      "PowerShell(Start-Process:*)",
      "PowerShell(dotnet run:*)",
      "PowerShell(dotnet test:*)",

      "PowerShell(Remove-Item:*)",
      "PowerShell(Stop-Process:*)"
    ],
    "deny": [
      "Edit(./docs/03_reference/*/source/**)",
      "Write(./docs/03_reference/*/source/**)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.snk)"
    ]
  }
}
